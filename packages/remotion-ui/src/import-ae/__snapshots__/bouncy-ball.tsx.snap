/**
 * BouncyBall — generated by `remotion-ui import-ae` from bouncy-ball.json (Bodymovin 5.5.2).
 * 512×512 at 60 fps, 120 frames.
 *
 * Plain data on top of `ae-motion`: keyframe frames are this composition's
 * frames, speed is units per second, scale is a factor and opacity is 0–1.
 * Edit a key, a colour or a layer's inPoint/outPoint/startTime and re-render.
 */
import {
  AeComposition,
  AeLayer,
  shapeLayer,
  group,
  ellipse,
  fill,
} from "@/remotion/lib/ae-import";

/** "Layer" — shape layer, frames 0–120. */
const layerLayer = shapeLayer({
  name: "Layer",
  inPoint: 0,
  outPoint: 120,
  contents: [
    group(
      "Ellipse Group",
      [ellipse({ position: [204, 169], size: [153, 153] }), fill({ color: "#b53046" })],
      {
        anchor: [204, 169],
        position: [
          { frame: 0, value: [235, 106], easeOut: { speed: 0, influence: 0.333 } },
          {
            frame: 60,
            value: [265, 441],
            easeIn: { speed: 0, influence: 0.001 },
            easeOut: { speed: 0, influence: 0.001 },
          },
          { frame: 120, value: [235, 106], easeIn: { speed: 0, influence: 0.333 } },
        ],
        scale: [
          { frame: 55, value: [1, 1], interpolation: "linear" },
          { frame: 60, value: [1.36, 0.59], interpolation: "linear" },
          { frame: 65, value: [1, 1] },
        ],
      },
    ),
  ],
});

export const Layer = () => <AeLayer layer={layerLayer} />;

/** The composition. Layers are listed bottom of the AE timeline first — later ones draw on top. */
export const BouncyBall = () => (
  <AeComposition width={512} height={512} fps={60}>
    <Layer />
  </AeComposition>
);

/** Register with `<Composition {...config} />`; `remotion-ui import-ae` adds it to Root.tsx for you. */
export const bouncyBallComposition = {
  id: "BouncyBall",
  component: BouncyBall,
  durationInFrames: 120,
  fps: 60,
  width: 512,
  height: 512,
};
