# Early-access waitlist storage (Supabase).
# Server-only. The secret/service key bypasses RLS — never expose it to the
# client and never prefix it with NEXT_PUBLIC_. Set both in Vercel; without
# them /api/early-access answers 503 instead of writing.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Live traffic numbers on /sponsor (Vercel Web Analytics API). Server-only.
# A Vercel access token with read access to the project. Without these the
# page shows the hand-copied snapshot in lib/sponsor-traffic.ts.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=prj_<project-id>
VERCEL_ANALYTICS_TEAM_ID=team_<team-id>
